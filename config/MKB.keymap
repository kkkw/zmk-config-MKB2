// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(64)>, <&msc MOVE_Y(-64)>;
            // One 16ms &msc tick produces floor(64 * 16 / 1000) = 1 event.
            // Release before the second tick to avoid delay and queue buildup.
            tap-ms = <24>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_qw_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <DEF>;
            bindings = <&kp ESC>;
        };

        combo_jk_lang1 {
            timeout-ms = <50>;
            key-positions = <19 20>;
            layers = <DEF>;
            bindings = <&kp LANG1>;
        };

        combo_as_caps_word {
            timeout-ms = <50>;
            key-positions = <13 14>;
            layers = <DEF>;
            bindings = <&caps_word>;
        };

        combo_df_lang2 {
            timeout-ms = <50>;
            key-positions = <15 16>;
            layers = <DEF>;
            bindings = <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESC    &kp Q     &kp W      &kp E     &kp R        &kp T            &kp Y        &kp U                &kp I      &kp O      &kp P           &kp BKSP
&lt 5 TAB  &kp A     &kp S      &kp D     &kp F        &kp G            &kp H        &kp J                &kp K      &kp L      &kp COLON       &kp ENTER
&kp LSHFT  &kp Z     &kp X      &kp C     &kp V        &kp B            &kp N        &kp M                &kp COMMA  &kp DOT    &mt RALT QMARK  &mt RIGHT_SHIFT MINUS
&kp LCTRL  &kp LALT  &kp LGUI             &lt 3 LANG2  &lt 1 SPACE      &lt 2 SPACE  &mt RIGHT_GUI LANG1             &mkp MB1   &mkp MB2        &mkp MB3
&kp LEFT   &kp UP    &kp ENTER  &kp DOWN  &kp RIGHT                                  &kp HOME             &kp PG_UP  &kp ENTER  &kp PG_DN       &kp END
                                &kp A                                                                     &kp B
            >;

            sensor-bindings = <&scroll_encoder &inc_dec_kp PG_UP PG_DN>;
        };

        symbol_layer {
            label = "Sym";
            bindings = <
&trans  &trans                 &kp AMPERSAND    &kp ASTRK    &kp LEFT_PARENTHESIS  &kp PIPE     &trans  &kp GRAVE  &kp TILDE  &kp LEFT_BRACKET   &kp LEFT_BRACE     &trans
&trans  &trans                 &kp DLLR         &kp PERCENT  &kp CARET             &kp BSLH     &trans  &kp SEMI   &kp COLON  &kp RIGHT_BRACKET  &kp RIGHT_BRACE    &trans
&trans  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION  &kp AT       &kp HASH              &kp SLASH    &trans  &kp EQUAL  &kp PLUS   &kp SINGLE_QUOTE   &kp DOUBLE_QUOTES  &kp UNDER
&trans  &trans                 &trans           &trans       &trans                             &trans        &trans  &trans                &trans             &trans             &trans
&trans  &kp LEFT               &kp UP           &kp SPACE    &kp DOWN              &kp RIGHT                          &kp HOME   &kp PG_UP  &kp ENTER          &kp PG_DN          &kp END
                                                     &kp A                                                             &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans  &trans    &kp N7        &kp N8        &kp N9        &trans     &trans      &trans      &kp UP_ARROW  &trans      &trans      &trans
&trans  &trans    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans     &trans      &kp LEFT    &kp DOWN      &kp RIGHT   &trans      &trans
&trans  &kp N0    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &kp LG(N1)  &kp LG(N2)  &kp LG(N3)     &kp LG(N4)  &kp LG(N5)  &trans
&trans  &trans    &trans        &trans                      &trans     &trans      &trans                    &trans      &trans      &trans
&trans  &kp LEFT  &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                          &kp HOME    &kp PG_UP     &kp ENTER   &kp PG_DN   &kp END
                                      &kp A                                                        &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&trans  &to 4     &kp F7  &kp F8     &kp F9    &kp LG(SPACE)            &kp LG(LS(NUMBER_4))  &kp LC(LA(F))         &trans     &kp LC(LA(H))  &kp LC(LA(LS(UP_ARROW)))  &trans
&trans  &trans    &kp F4  &kp F5     &kp F6    &kp LS(LG(V))             &kp LS(LC(LG(NUMBER_4)))  &trans                &trans     &trans         &trans                    &trans
&trans  &kp F10   &kp F1  &kp F2     &kp F3    &trans                       &kp LC(LS(X))              &kp LC(LS(SPACE))       &kp LC(LS(PG_UP))  &kp LC(LS(PG_DN))  &kp LG(LS(A))              &trans
&trans  &trans    &trans  &trans               &trans                   &trans                    &trans                           &trans         &trans                    &trans
&trans  &kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                                                    &kp LG(LEFT_BRACKET)  &kp LG(R)  &kp ENTER      &kp LG(W)                 &kp LG(RIGHT_BRACKET)
                             &kp A                                                                                &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&to 0     &trans  &trans     &trans    &trans     &trans      &trans     &trans    &kp UP    &trans     &trans  &trans
&trans    &trans  &trans     &trans    &trans     &trans      &kp LC(D)  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans    &trans  &trans     &trans    &trans     &trans      &kp LC(C)  &trans    &trans    &trans     &trans  &trans
&trans    &trans  &trans               &trans     &trans      &trans     &trans              &trans     &trans  &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                         &trans    &trans    &kp ENTER  &trans  &trans
                             &kp A                                                 &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR_ALL  &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans            &trans          &trans               &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                       &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                                   &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
